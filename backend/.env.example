# Set these as Vercel project secrets; do not commit actual values.
CRISP_ENV=production
CRISP_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
CRISP_ENCRYPTION_KEY=REPLACE_WITH_A_PERSISTENT_FERNET_KEY

# For a local API and local SQLite instead, omit CRISP_DATABASE_URL and use:
# CRISP_ENV=development
# CRISP_DATABASE_PATH=/absolute/path/to/crisp.sqlite3
