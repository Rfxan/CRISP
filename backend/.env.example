# Set these as Vercel project secrets; do not commit actual values.
CRISP_ENV=production
# Hosted APIs are public read-only demos; editing is local development only.
CRISP_ACCESS_MODE=public_demo
CRISP_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
CRISP_ENCRYPTION_KEY=REPLACE_WITH_A_PERSISTENT_FERNET_KEY

# For a local API and local SQLite instead, omit CRISP_DATABASE_URL and use:
# CRISP_ENV=development
# CRISP_DATABASE_PATH=/absolute/path/to/crisp.sqlite3
# CRISP_ACCESS_MODE=local

# Optional: exact HTTPS origins approved for server-to-server integrations.
# CRISP_OUTBOUND_ORIGINS=https://wazuh.example.com:55000
# CRISP_INTEGRATION_CA_BUNDLE=/etc/crisp/integration-ca.pem
# Private approved origins additionally require CRISP_ALLOW_PRIVATE_OUTBOUND=1.
