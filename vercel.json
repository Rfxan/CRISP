{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "devCommand": "npm run dev",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "https://crisp-backend-github.onrender.com/api" },
    { "source": "/api/:path*", "destination": "https://crisp-backend-github.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
